.installed.cfg
*.egg
MANIFEST

# Pytest / Test Artifacts / Coverage
**/.pytest_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Local SQLite & Cache Databases (Binary files grow quickly)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite3-journal
follow_the_green.db
test_memory.db
clover.db

# Archives & Large Zips (Avoid committing zipped projects)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
clover-extracted/

# Environment Variables & Secrets (Sensitive & machine-specific)
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Operating System & IDE
.DS_Store
.DS_Store?
._*
