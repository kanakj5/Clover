# ==============================================================================
# Clover Environment Configuration
# ==============================================================================
# Copy this file to .env to configure local simulation or live cluster connections.
# The system runs fully in local SIMULATION mode without any secrets or live clusters.
# ==============================================================================

# Application Operating Mode: SIMULATION | LIVE
OPERATING_MODE=SIMULATION

# YugabyteDB PostgreSQL-Compatible Interface (Required only for LIVE mode)
YUGABYTEDB_HOST=localhost
YUGABYTEDB_PORT=5433
YUGABYTEDB_DATABASE=yugabyte
YUGABYTEDB_USER=yugabyte
YUGABYTEDB_PASSWORD=
YUGABYTEDB_SSLMODE=prefer
YUGABYTEDB_CONNECT_TIMEOUT=4

# Carbon Intensity Telemetry Provider: DEMO | EXTERNAL
# DEMO: Offline deterministic diurnal grid curves (zero API keys needed)
# EXTERNAL: Live emissions via Electricity Maps / WattTime
CARBON_PROVIDER=DEMO
CARBON_API_KEY=
CARBON_API_URL=

# Meko Intelligent Memory Integration (Optional)
# When false, uses fully functional local SQLite persistent memory table
MEKO_ENABLED=false
MEKO_API_ENDPOINT=
MEKO_API_KEY=

# Google Gemini AI Decision Maker (Optional)
# Leave blank to use built-in offline Gemini Cognitive Engine with full step-by-step reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash


# Optimization Policy Defaults
COOLDOWN_SECONDS=120
MIN_CARBON_REDUCTION_PCT=10.0
MAX_LATENCY_INCREASE_MS=20.0
ACTIVE_WORKLOAD=CHECKOUT
SQLITE_DB_PATH=follow_the_green.db
